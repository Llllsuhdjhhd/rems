# ---- LLM ----
REMS_LLM__API_KEY=sk-your-dashscope-api-key
REMS_LLM__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- Model mapping (task -> model name) ----
# REMS_LLM__TASK_MODELS__SUMMARY=qwen-turbo
# REMS_LLM__TASK_MODELS__BOUNDARY_DETECTION=qwen-plus
# REMS_LLM__TASK_MODELS__ROLE_EXTRACTION=qwen-plus
# REMS_LLM__TASK_MODELS__ABSTRACTION=qwen-max

# ---- Embedding ----
REMS_EMBEDDING__PROVIDER=local
REMS_EMBEDDING__MODEL_NAME=BAAI/bge-small-zh-v1.5

# ---- Storage ----
REMS_STORAGE__DATABASE_URL=sqlite:///rems.db
REMS_STORAGE__CHROMADB_PATH=./chroma_data

# ---- Context window ----
REMS_CONTEXT_WINDOW=32768
REMS_CHARS_PER_TOKEN=1.5

# ---- Recall: role-aware summary tier selection ----
# 默认召回摘要档位（0=中间级，负数=更精细，正数=更压缩）
# REMS_RECALL_DEFAULT_TIER_OFFSET=0
# 主角（S/A）在默认档位上向 L1 方向再偏移的档数
# REMS_RECALL_PRIMARY_ROLE_DETAIL_SHIFT=1
# 配角/无关角色在默认档位上向高压缩方向偏移的档数
# REMS_RECALL_MINOR_ROLE_COMPRESS_SHIFT=1
# 摘要最低字数门槛（低于此值则不再压缩）
# REMS_RECALL_SUMMARY_MIN_CHARS=20

# ---- Affective Energy (AE) ----
# REMS_AE_HIGH_THRESHOLD=0.6
# REMS_AE_SCORE_WEIGHT=0.15

# ---- White-painting forgetting ----
# REMS_WP_HALF_LIFE_DAYS=60.0
# REMS_AE_FORGETTING_MULTIPLIER=5.0

# ---- Hallucination control (abstraction anchor probability) ----
# REMS_HALLUCINATION_ANCHOR_PROB=0.3

# ---- Semantic card ----
# REMS_SEMANTIC_CARD_MAX_KEYS=20


